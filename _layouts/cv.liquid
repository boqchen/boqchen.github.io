---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
  </header>

  <article>
    {% if page.cv_pdf %}
      <div class="cv-placeholder">
        <a
          class="btn btn-sm z-depth-0 cv-placeholder-button"
          href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg
            class="pdf-icon"
            viewBox="0 0 64 64"
            role="img"
            aria-label="PDF"
          >
            <path
              class="pdf-icon-document"
              d="M17 4h23l12 12v35a9 9 0 0 1-9 9H17a9 9 0 0 1-9-9V13a9 9 0 0 1 9-9Z"
            />
            <path class="pdf-icon-fold" d="M40 4v12h12Z" />
            <rect class="pdf-icon-label" x="13" y="32" width="38" height="18" rx="4" />
            <text class="pdf-icon-text" x="32" y="46" text-anchor="middle">PDF</text>
          </svg>
          Open CV PDF
        </a>
      </div>
    {% endif %}
  </article>
</div>
