<div class="news" style="margin-bottom: 2rem;">
  {% if site.news != blank %}
    {% assign news = site.news | reverse %}
    <div class="table-responsive"{% if include.limit %} style="max-height: 40vh"{% endif %}>
      <ul class="news-list">
        {% for item in news %}
          <li>
            <span class="news-date">[{{ item.date | date: '%b, %Y' }}]</span>
            {% if item.inline %}
              {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
            {% else %}
              <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
